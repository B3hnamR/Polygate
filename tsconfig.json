{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "allowJs": true, "checkJs": false, "strict": true, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true, "types": ["bun", "vite/client"]
  },
  "include": ["backend/**/*.ts", "src/**/*.tsx", "src/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vite.config.ts"]
}
