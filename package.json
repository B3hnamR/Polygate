{
  "name": "polygate",
  "version": "0.6.1",
  "private": true,
  "license": "MIT",
  "description": "A free model gateway for Windows and Linux with WARP and a proxy pool",
  "author": "Polygate",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun backend/main.ts",
    "test": "bun test tests",
    "test:windows-native": "bun test tests/updates.test.ts tests/agent-integrity-regressions.test.ts --test-name-pattern \"atomically replaces an executable with spaces and apostrophes in its path|rejects tampered bytes while preserving the original|a portable executable named after its version is renamed to the new version, and any other name is left alone|one click downloads, verifies, closes the old process, replaces the file, and launches the replacement|the helper waits for the old app without failing when it has already gone|alternate-case backup paths and exclusions never turn an existing Windows file into an addition|Undo coalesces alternate-case identities across persisted Windows turns\" --reporter=junit --reporter-outfile=build/verification/windows-native.xml",
    "check": "tsc --noEmit",
    "build:ui": "vite build",
    "build:gateway": "bun build backend/main.ts --target bun --outfile build/gateway.js",
    "build:runtime": "python scripts/bundle-bun.py",
    "build": "bun run check && bun run build:ui && bun run build:gateway && bun run build:runtime",
    "dist": "bun scripts/build-desktop.ts",
    "desktop": "electron .",
    "build:linux": "bash scripts/build-linux.sh amd64",
    "verify:pool": "bun scripts/verify-pool.ts",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:crawl": "node scripts/ui-crawl.mjs",
    "verify:scenarios": "node scripts/ui-scenarios.mjs",
    "verify:acme": "bash scripts/verify-acme.sh",
    "verify:installer": "bash scripts/verify-installer.sh"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/doto": "5.3.0",
    "@playwright/test": "^1.51.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "dev.polygate.desktop",
    "productName": "Polygate",
    "extraMetadata": {
      "description": "Polygate"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "ui"
      },
      {
        "from": "build/gateway.js",
        "to": "gateway.js"
      },
      {
        "from": "build/bin/bun.exe",
        "to": "bin/bun.exe"
      },
      {
        "from": "resources/warp/usque-windows-amd64.exe",
        "to": "warp/usque-windows-amd64.exe"
      },
      {
        "from": "resources/warp/LICENSE",
        "to": "warp/LICENSE"
      },
      {
        "from": "resources/warp/README.md",
        "to": "warp/README.md"
      },
      {
        "from": "resources/warp/usque.patch",
        "to": "warp/usque.patch"
      },
      {
        "from": "resources/warp/sha256.txt",
        "to": "warp/sha256.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "relays",
        "to": "relays"
      },
      {
        "from": "vendor/licenses",
        "to": "licenses",
        "filter": ["**/*"]
      },
      {
        "from": "vendor/bridge/LICENSE",
        "to": "licenses/bridge-LICENSE"
      },
      {
        "from": "vendor/protocols/LICENSE",
        "to": "licenses/protocols-LICENSE"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Polygate-${version}-Windows-x64.exe",
      "signExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
